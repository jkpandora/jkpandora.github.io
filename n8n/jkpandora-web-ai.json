      "id": "mdaily"
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "command": "=cd /data/cloud_1tb/jkpandora.github.io && git pull -q --rebase; MODE={{ $json.mode }} LANG=C.UTF-8 PYTHONIOENCODING=utf-8 python3 tools/ai_publish.py",
        "cwd": "/data/cloud_1tb/jkpandora.github.io"
      },
      "name": "เก็บสถานะ + AI วิเคราะห์ + อัปเว็บ (SSH)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        460,
        100
      ],
      "id": "run",
      "credentials": {
        "sshPrivateKey": {
          "id": "",
          "name": "VPS SSH Key (n8n)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json.stdout || '';\nreturn [{ json: JSON.parse(out.trim().split('\\n').pop()) }];"
      },
      "name": "อ่านผล",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        100
      ],
      "id": "parse"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.notify }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "ต้องแจ้ง Telegram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        100
      ],
      "id": "if"
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "command": "=cd /data/cloud_1tb/aetox-harness && set -a && . ./.env && set +a && echo '{{ $json.msg_b64 }}' | base64 -d > /tmp/web_msg.txt && echo 'https://jkpandora.github.io/projects/aetox-vps/' >> /tmp/web_msg.txt && curl -s -X POST \"https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage\" -d chat_id=\"$TELEGRAM_CHAT_ID\" --data-urlencode text@/tmp/web_msg.txt",
        "cwd": "/data/cloud_1tb/aetox-harness"
      },
      "name": "แจ้ง Telegram JKth01",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
